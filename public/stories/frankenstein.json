      "scene": {
        "id": "geneva_home",
        "name": "弗兰肯斯坦家",
        "type": "major",
        "description": "熟悉的庭院，但一切都安静得不对劲。",
        "arrival": "天亮时你进城，父亲在门口等着你。"
      },
      "progress": 39,
