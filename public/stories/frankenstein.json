  "nodes": {
    "f_start": {
      "chapterTitle": "序章：北极冰原",
      "title": "沃尔顿的日志",
      "scene": {
        "id": "arctic",
        "name": "北极冰原",
        "type": "major",
        "description": "无边的白色。冰块互相挤压，发出低沉的碎裂声。风从四面来，没有方向。",
        "arrival": "冰封的海面上，沃尔顿的探险船已经动弹不得三天了。"
      },
      "progress": 2,
      "segments": [
        { "text": "一八一七年，北极。罗伯特·沃尔顿的探险船被困在冰中，向北的路已经封死。" },
        { "text": "昨天，瞭望手看到了什么——一个驾着雪橇的巨大身影，在暮色中飞速消失。" },
        { "text": "今天早晨，他们在浮冰上又发现了另一个人。" }
      ],
      "choices": [
        { "text": "看那个被救上来的人", "next": "f_rescue" }
      ]
    },

    "f_rescue": {
      "title": "冰上的陌生人",
      "scene": { "id": "arctic", "name": "北极冰原", "type": "major" },
      "progress": 4,
      "segments": [
        { "text": "他们用绳索将他拖上甲板。他几乎不像活人——皮肤冻成青灰，眼眶深陷，但眼睛里有火。" },
        { "text": "三天后，陌生人能坐起来了。他打量着沃尔顿，声音沙哑：" },
        { "speaker": "陌生人", "text": "「你们……是往北走？还是南返？」" }
      ],
      "choices": [
        {
          "text": "「北上。我在寻找北极航道。」",
          "next": "f_victor_speaks",
          "changes": { "val": 5 }
        },
        {
          "text": "「冰封住了。我们正商量是否折返。」",
          "next": "f_victor_speaks"
        }
      ]
    },

    "f_victor_speaks": {
      "title": "维克多的故事",
      "scene": { "id": "arctic", "name": "北极冰原", "type": "major" },
      "progress": 6,
      "segments": [
        { "text": "陌生人盯着沃尔顿，像是在决定什么。" },
        { "speaker": "陌生人", "text": "「你在追求知识。」他说，不是问句。「我也曾经如此。」" },
        { "speaker": "陌生人", "text": "「我叫维克多·弗兰肯斯坦。如果你愿意听，我来告诉你，一个追求知识的人，最终会走到哪里。」" },
        { "text": "这是你的故事。" }
      ],
      "choices": [
        { "text": "听下去", "next": "ch1_youth" }
      ]
    },

    "ch1_youth": {
      "chapterTitle": "第一章：英戈尔施塔特",
      "title": "日内瓦的童年",
      "scene": {
        "id": "geneva",
        "name": "日内瓦",
        "type": "major",
        "description": "阿尔卑斯山脚下的湖畔城市，古老的石屋与教堂尖顶，湖水清澈。",
        "arrival": "记忆从日内瓦开始——那里有阳光，有湖水，有一切你后来失去的东西。"
      },
      "progress": 8,
      "segments": [
        { "text": "你生长在一个富裕而温暖的家庭。父亲阿方斯待你如珍宝，母亲卡罗琳温柔而聪慧。" },
        { "text": "还有伊丽莎白——她不是你的亲妹妹，是父亲从一户贫苦家庭领养的孤女。金发，眼神坦诚，笑起来像湖面的波光。" },
        { "text": "还有亨利·克莱尔沃，你最好的朋友，热爱诗歌和冒险故事，总能在你沉默时把你拉回来。" }
      ],
      "choices": [
        { "text": "继续", "next": "ch1_mother_death" }
      ]
    },

    "ch1_mother_death": {
      "title": "母亲之死",
      "scene": { "id": "geneva", "name": "日内瓦", "type": "major" },
      "progress": 10,
      "segments": [
        { "text": "十五岁那年，一场猩红热席卷了日内瓦。母亲卡罗琳在照顾病倒的伊丽莎白时染病，没有撑过去。" },
        { "text": "她去世前握着你的手，把伊丽莎白的手也放进来。" },
        { "speaker": "卡罗琳", "text": "「孩子们，你们彼此是最好的慰藉。」" },
        { "text": "然后她闭上了眼睛。你第一次真切地感受到——生命，是可以被取走的。" }
      ],
      "choices": [
        {
          "text": "想起母亲死时的样子，你第一次想：如果不是这样……",
          "next": "ch1_ingolstadt",
          "changes": { "val": -5 }
        },
        {
          "text": "你压下这个念头，为她守夜",
          "next": "ch1_ingolstadt"
        }
      ]
    },

    "ch1_ingolstadt": {
      "title": "英戈尔施塔特",
      "scene": {
        "id": "university",
        "name": "英戈尔施塔特大学",
        "type": "major",
        "description": "德意志的大学城，石砌的教学楼，图书馆里混合着皮革和蜡烛的气味。",
        "arrival": "几年后，你离开日内瓦，前往英戈尔施塔特大学。"
      },
      "progress": 13,
      "segments": [
        { "text": "英戈尔施塔特的教授们分为两类。克雷普教授属于让你失望的那类，他在课上嘲笑你少年时迷恋的炼金术师，说那些都是「过时的胡言乱语」。" },
        { "text": "但瓦尔曼教授不同。他在第一堂课上说的话，你此后反复回想：" },
        { "speaker": "瓦尔曼", "text": "「现代科学家不满足于少数事实。他们穿透自然的藏匿处，展示她如何在她的隐秘处运作。」" }
      ],
      "choices": [
        {
          "text": "「他说的是真的——自然真的有秘密可以被穿透？」",
          "next": "ch1_obsession_begins",
          "changes": { "val": 5 }
        },
        {
          "text": "这番话让你不安，但你还是留了下来",
          "next": "ch1_obsession_begins"
        }
      ]
    },

    "ch1_obsession_begins": {
      "title": "着迷",
      "scene": { "id": "university", "name": "英戈尔施塔特大学", "type": "major" },
      "progress": 16,
      "segments": [
        { "text": "接下来的两年，你几乎没有离开过实验室和解剖室。" },
        { "text": "你研究腐败，研究死亡，研究生命力的本质——那个在肉体停止时离开的东西，究竟是什么。" },
        { "text": "你不再给日内瓦写信，不再问亨利近况，不再想伊丽莎白的样子。" }
      ],
      "choices": [
        {
          "text": "继续深入——你感到自己越来越接近某个答案",
          "next": "ch1_anatomy",
          "changes": { "val": 10 }
        },
        {
          "text": "有时你停下来，想想这是否走得太远了",
          "next": "ch1_anatomy",
          "changes": { "val": -5 }
        }
      ]
    },

    "ch1_anatomy": {
      "title": "解剖室",
      "scene": { "id": "university", "name": "英戈尔施塔特大学", "type": "major" },
      "progress": 19,
      "segments": [
        { "text": "你开始收集材料。屠宰场，墓地，解剖室。" },
        { "text": "你告诉自己：这一切都是为了更大的目标。征服死亡。让失去母亲的人不再失去。" },
        { "text": "但在最深的夜晚，蜡烛将熄，你手里拿着某样东西——你知道，你做这件事，只是因为你想知道能不能做到。" }
      ],
      "choices": [
        { "text": "继续。你已经太近了。", "next": "ch1_creation_night" }
      ]
    },

    "ch1_creation_night": {
      "title": "那个十一月的夜晚",
      "scene": {
        "id": "lab",
        "name": "实验室",
        "type": "major",
        "description": "蜡烛，解剖台，电气仪器。外面的雨打在窗上。",
        "arrival": "这是你工作了两年的地方。今夜与往日不同。"
      },
      "progress": 22,
      "segments": [
        { "text": "十一月一个阴雨的夜晚。两点钟。" },
        { "text": "你站在实验台前，手指颤抖。台上的东西安静地躺着，等待。" },
        { "text": "你接通了电路。" }
      ],
      "choices": [
        {
          "text": "看着它",
          "next": "ch1_moment",
          "changes": { "unlockAchievement": "ach_creation", "addFlag": "creation_witnessed" }
        }
      ]
    },

    "ch1_moment": {
      "title": "生命降临",
      "scene": { "id": "lab", "name": "实验室", "type": "major" },
      "progress": 24,
      "segments": [
        { "text": "黄腊色的皮肤收紧了。" },
        { "text": "眼皮动了。" },
        { "text": "一双水汪汪的眼睛，无神而又充满光，缓缓转向了你。" },
        { "text": "它呼吸了。" }
      ],
      "choices": [
        {
          "text": "留下来",
          "next": "ch1_face",
          "changes": { "addFlag": "monster_first_seen", "val": 15 }
        },
        {
          "text": "逃出实验室",
          "next": "ch1_flee",
          "changes": { "val": -10 }
        }
      ]
    },

    "ch1_face": {
      "title": "正视",
      "scene": { "id": "lab", "name": "实验室", "type": "major" },
      "progress": 26,
      "segments": [
        { "text": "你没有跑。" },
        { "text": "它慢慢坐起来，身体的每一个动作都陌生而又精确，像是在学习怎么使用这副躯壳。" },
        { "text": "它把手伸向你——那只手，黄色的皮肤下青筋可见，比人的手大了将近一倍。" }
      ],
      "choices": [
        {
          "text": "握住那只手",
          "next": "ch1_touch",
          "changes": { "val": 10 }
        },
        {
          "text": "退后一步，但没有跑",
          "next": "ch1_nightmare",
          "changes": { "val": 5 }
        }
      ]
    },

    "ch1_touch": {
      "title": "接触",
      "scene": { "id": "lab", "name": "实验室", "type": "major" },
      "progress": 27,
      "segments": [
        { "text": "它的手很凉，但不是死人的凉——是刚刚活过来的凉，像是体温还没来得及分布均匀。" },
        { "text": "它看着你，嘴唇动了，发出喉间的声音，不成语言，但有某种节奏。" },
        { "text": "你握着它的手站了很久。天亮时，亨利在门外敲门。" },
        { "text": "你开门，亨利看着你的脸，皱起眉头。" },
        { "speaker": "亨利", "text": "「维克多，你……你还好吗？」" },
        { "text": "你回头看了看实验室——它不见了。不知什么时候，它已经悄悄走掉了。" }
      ],
      "choices": [
        {
          "text": "「没事，只是没睡好。」",
          "next": "ch1_nightmare",
          "changes": { "unlockAchievement": "ach_hidden", "val": 5 }
        }
      ]
    },

    "ch1_flee": {
      "title": "逃跑",
      "scene": { "id": "corridor", "name": "走廊", "type": "minor", "description": "石砌走廊，蜡烛在风中摇曳。" },
      "progress": 26,
      "segments": [
        { "text": "你跑了出去。走廊，楼梯，院子，街道。雨还在下。" },
        { "text": "天色将白时，你停下来，靠着一棵树。你一遍遍告诉自己：你只是太疲倦了，看到了幻觉。" }
      ],
      "choices": [
        {
          "text": "但你知道那不是幻觉",
          "next": "ch1_nightmare"
        }
      ]
    },

    "ch1_nightmare": {
      "title": "亨利来了",
      "scene": { "id": "university", "name": "英戈尔施塔特大学", "type": "major" },
      "progress": 28,
      "segments": [
        { "text": "你病倒了。烧了足足两个月，时常在梦中惊醒。" },
        { "text": "当你清醒时，亨利坐在床边——他不知道怎么回事，只是在那里。" },
        { "speaker": "亨利", "text": "「你在说梦话，」他笑着说，「伊丽莎白让我转告你，她每天都在等你的信。」" },
        { "text": "你没有告诉亨利实验室里的事。当你终于能下床，回到那个房间——实验台空了，什么都不见了。" }
      ],
      "choices": [
        { "text": "继续", "next": "ch2_letter" }
      ]
    },

    "ch2_letter": {
      "chapterTitle": "第二章：贾斯汀的命运",
      "title": "威廉的死",
      "scene": { "id": "university", "name": "英戈尔施塔特大学", "type": "major" },
      "progress": 31,
      "segments": [
        { "text": "康复后的几个月是暂时的平静。亨利带着你去看艺术，去湖边散步，谈诗谈旅行。" },
        { "text": "然后父亲的信来了。你读了第一句就停下了。" },
        { "speaker": "阿方斯", "text": "「维克多，我亲爱的孩子，一场莫大的不幸降临在我们家。威廉死了……」" }
      ],
      "choices": [
        { "text": "把信读完", "next": "ch2_william_details" }
      ]
    },

    "ch2_william_details": {
      "title": "威廉",
      "scene": { "id": "university", "name": "英戈尔施塔特大学", "type": "major" },
      "progress": 33,
      "segments": [
        { "text": "威廉，你最小的弟弟，五岁，在普兰帕莱斯草地散步时失踪，第二天早晨被发现在草丛里，脖子上有指痕。" },
        { "text": "你立刻动身。从英戈尔施塔特到日内瓦，你几乎不睡觉，脑子里什么都不想，只是赶路。" }
      ],
      "choices": [
        { "text": "继续赶路", "next": "ch2_return_night" }
      ]
    },

    "ch2_return_night": {
      "title": "夜雨",
      "scene": {
        "id": "road_geneva",
        "name": "日内瓦城门外",
        "type": "major",
        "description": "山路，黑暗，雷雨，远处城门的火把。",
        "arrival": "你在深夜接近日内瓦，城门已经关闭。"
      },
      "progress": 36,
      "segments": [
        { "text": "夜里，雷雨交加。你决定在城门外等到天明。" },
        { "text": "闪电打亮了山谷。" },
        { "text": "就在那一瞬间，你看到了它——在岩石上，一个巨大的轮廓，八尺高，动作矫健，在黑暗中移动。" },
        { "text": "雷声过去，什么都看不见了。" }
      ],
      "choices": [
        {
          "text": "追过去",
          "next": "ch2_chase_shadow",
          "changes": { "val": 5 }
        },
        {
          "text": "站在原地，等天亮",
          "next": "ch2_geneva_morning",
          "changes": { "val": -5 }
        }
      ]
    },

    "ch2_chase_shadow": {
      "title": "黑暗中",
      "scene": { "id": "road_geneva", "name": "日内瓦城门外", "type": "major" },
      "progress": 37,
      "segments": [
        { "text": "你跑过去，但什么都没有。只有雨，只有泥泞，只有山风。" },
        { "text": "它消失得太快了。" },
        { "text": "你想起了威廉的死，胃里像是有什么东西收紧了。" }
      ],
      "choices": [
        { "text": "等到天亮，进城", "next": "ch2_geneva_morning" }
      ]
    },

    "ch2_geneva_morning": {
