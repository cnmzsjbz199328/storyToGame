  "nodes": {
    "cr_start": {
      "chapterTitle": "序章：圣彼得堡，七月",
      "title": "阁楼",
      "scene": {
        "id": "attic",
        "name": "阁楼",
        "type": "major",
        "description": "圣彼得堡，夏天。五层楼顶的阁楼，天花板斜压下来，热得像烤箱。窗外是灰色的天空和屋顶。",
        "arrival": "你已经两个月没交房租了。"
      },
      "progress": 2,
      "segments": [
        { "text": "七月，圣彼得堡。热浪把城市里所有东西的气味都烤了出来——下水道，腐鱼，汗，石灰。" },
        { "text": "你的阁楼比棺材大不了多少。大衣当了，书当了，连茶炊也当了。" },
        { "text": "你还在想一件事。想了很久了。" }
      ],
      "choices": [
        { "text": "继续", "next": "cr_attic" }
      ]
    },

    "cr_attic": {
      "title": "那个想法",
      "scene": { "id": "attic", "name": "阁楼", "type": "major" },
      "progress": 4,
      "segments": [
        { "text": "你在脑子里把它转了一遍又一遍。不是第一次，但今天转得特别清楚。" },
        { "text": "世界上有两种人。普通人，受规则约束，活在道德的笼子里。还有非凡人——拿破仑那样的，他们有权利逾越，因为他们的目的更大。" },
        { "text": "问题只有一个：你是哪一种？" }
      ],
      "choices": [
        {
          "text": "「我是非凡人。」",
          "next": "cr_walk_out",
          "changes": { "val": -5, "unlockAchievement": "ach_theory" }
        },
        {
          "text": "「我不知道。」",
          "next": "cr_walk_out",
          "changes": { "val": 5, "unlockAchievement": "ach_theory" }
        }
      ]
    },

    "cr_walk_out": {
      "title": "出门",
      "scene": { "id": "street", "name": "圣彼得堡街头", "type": "major", "description": "运河边，石板路，人群，热浪，气味。", "arrival": "你出了门，往典当铺方向走。" },
      "progress": 6,
      "segments": [
        { "text": "街上的人把你挤来挤去。马车溅起泥水。一个醉汉靠着墙唱歌。" },
        { "text": "你朝爱-巷走去，那里住着一个老典当商。你之前去过一次，典当了手表。" },
        { "text": "这次你不是去典当东西的。" }
      ],
      "choices": [
        { "text": "走进那条巷子", "next": "cr_pawnbroker" }
      ]
    },

    "cr_pawnbroker": {
      "chapterTitle": "第一章：理论",
      "title": "典当商",
      "scene": { "id": "pawnshop", "name": "典当铺", "type": "minor", "description": "昏暗的公寓，挂满东西，气味混合着陈旧和霉味。" },
      "progress": 9,
      "segments": [
        { "text": "阿廖娜·伊万诺夫娜，六十多岁，身材矮小，眼睛像老鼠一样机警。她看了看你带来的东西，出了个压低的价。" },
        { "speaker": "阿廖娜", "text": "「这个，一卢布半。上次的利息你也欠着。」" },
        { "text": "你接过钱，什么都没说。你在心里记下了：两把锁，门的布局，什么时候她一个人在家。" }
      ],
      "choices": [
        {
          "text": "把细节再记清楚一些",
          "next": "cr_theory_born",
          "changes": { "val": -5 }
        },
        {
          "text": "走出去，在楼道里站了一会儿",
          "next": "cr_theory_born"
        }
      ]
    },

    "cr_theory_born": {
      "title": "理论成形",
      "scene": { "id": "street", "name": "圣彼得堡街头", "type": "major" },
      "progress": 11,
      "segments": [
        { "text": "她是虱子，你在走回阁楼的路上这样想。吸人血的虱子，没有任何用处，只会把穷人的最后一点东西压低了要走。" },
        { "text": "如果你把她的钱拿来，用在真正有意义的事情上——救母亲，完成学业，帮助一百个穷人——这算犯罪吗？" },
        { "text": "一个虱子的命，换一百人的前途。数学题。" }
      ],
      "choices": [
        {
          "text": "这个逻辑没有问题",
          "next": "cr_tavern",
          "changes": { "val": -5 }
        },
        {
          "text": "但有什么东西让你停下来",
          "next": "cr_tavern",
          "changes": { "val": 5 }
        }
      ]
    },

    "cr_tavern": {
      "title": "小酒馆",
      "scene": { "id": "tavern", "name": "小酒馆", "type": "minor", "description": "嘈杂，蜡烛，烟，大桌子。" },
      "progress": 13,
      "segments": [
        { "text": "你进了一家小酒馆，要了一杯啤酒，找了个角落坐下。" },
        { "text": "旁边那桌有个男人，穿着旧官服，眼睛通红，一看就是喝了很久的那种喝法。他扫了你一眼，像是要找个人说话。" },
        { "speaker": "玛尔美拉多夫", "text": "「年轻人，你愿意听一个可悲的人说话吗？」" }
      ],
      "choices": [
        {
          "text": "「说吧。」",
          "next": "cr_marmeladov_story"
        },
        {
          "text": "扭过头去",
          "next": "cr_marmeladov_story"
        }
      ]
    },

    "cr_marmeladov_story": {
      "title": "玛尔美拉多夫",
      "scene": { "id": "tavern", "name": "小酒馆", "type": "minor" },
      "progress": 15,
      "segments": [
        { "text": "他叫玛尔美拉多夫，前九等文官，如今什么都不是。他说他有个女儿索尼娅，为了供一家人吃饭，走了一条让他羞愧的路。" },
        { "speaker": "玛尔美拉多夫", "text": "「她去那里，是为了我这个废物，是为了她的继母和弟弟妹妹们。她把钱放在桌上，什么都没说，走了。」" },
        { "text": "他喝了一口，把酒杯重重地放下来。" },
        { "speaker": "玛尔美拉多夫", "text": "「我又把那些钱喝掉了。」" }
      ],
      "choices": [
        { "text": "继续听", "next": "cr_letter" }
      ]
    },

    "cr_letter": {
      "title": "母亲的信",
      "scene": { "id": "attic", "name": "阁楼", "type": "major" },
      "progress": 17,
      "segments": [
        { "text": "回到阁楼，桌上有一封信。母亲的字迹，从省里寄来的。" },
        { "text": "信里说，妹妹杜尼亚找到了工作，在一个叫斯维德里盖洛夫的地主家做家庭教师，但出了一些让人不安的事，现在她打算嫁给一个叫卢任的律师——" },
        { "text": "母亲写道：「他不算年轻，但有地位，可以保护我们的杜尼亚，也许也能帮你。」" }
      ],
      "choices": [
        {
          "text": "「她是为了我。」",
          "next": "cr_decision_forming",
          "changes": { "val": 5 }
        },
        {
          "text": "把信折起来，不再想",
          "next": "cr_decision_forming",
          "changes": { "val": -5 }
        }
      ]
    },

